# Modelo de referência. Prefira `npm run secrets:init`; o arquivo real fica ignorado pelo Git.
# Credenciais exclusivamente locais.
POSTGRES_DB=app_do_amor_local
POSTGRES_USER=app_do_amor_local
POSTGRES_PASSWORD=substitua-por-uma-senha-local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app_do_amor_local:substitua-por-uma-senha-local@127.0.0.1:5432/app_do_amor_local
