# Modelo de referência. Prefira `npm run secrets:init` para criar .env.local com valores fortes.
# Somente dados ficticios. Nao adicionar segredos com prefixo VITE_.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# Caminho relativo a raiz do repositorio, de onde o comando deve ser executado.
DATABASE_FILE=server/data/database.json
# PostgreSQL local iniciado conforme docs/BANCO-DE-DADOS-E-MIGRACOES.md.
# Enquanto estiver vazia, o protótipo usa o fallback JSON; ambientes remotos não podem usar fallback.
DATABASE_URL=postgresql://app_do_amor_local:substitua-por-uma-senha-local@127.0.0.1:5432/app_do_amor_local
# Diretório do frontend compilado servido pelo processo Node.
STATIC_DIR=dist
# Contas administrativas locais separadas por virgula. Vazio por padrao.
ADMIN_EMAILS=
# Origens permitidas para o envio anônimo do feedback, separadas por vírgula.
APP_ORIGIN=http://127.0.0.1:5173
# Use pelo menos 32 caracteres aleatórios. Nunca use prefixo VITE_ neste segredo.
MPV_EXPORT_TOKEN=substitua-por-um-token-aleatorio-com-32-caracteres
# Feedbacks vencidos são removidos quando um novo envio é recebido.
MPV_FEEDBACK_RETENTION_DAYS=90
